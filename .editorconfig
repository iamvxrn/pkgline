root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{toml,yml,yaml,json,js,mjs,cjs,ts,vue,html,css}]
indent_style = space
indent_size = 2
